# Supabase Configuration
# Copy this file to .env.local and fill in your actual Supabase credentials from Project Settings > API

# Your Supabase Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous API Key (anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Optional - Server Only) Supabase Service Role Key for administrative tasks
# WARNING: NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client-side code
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
